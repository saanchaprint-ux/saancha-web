# Supabase — apni keys yahan daalo (Settings → API)
# .env file GitHub pe nahi jaati (gitignore me hai). Vercel me alag se daalni hai.
PUBLIC_SUPABASE_URL=your-project-url
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin panel (Phase 1)
ADMIN_PASSWORD=choose-a-strong-secret
SUPABASE_SERVICE_ROLE=your-service-role-key-from-supabase-settings-api

# Required for secure signed administrator sessions (64+ random hex characters recommended)
ADMIN_SESSION_SECRET=replace-with-random-strong-secret

# SEO: Replace with verification token from Google Search Console (HTML tag method)
GOOGLE_SITE_VERIFICATION=
# Analytics: Replace with your GA4 Measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=
