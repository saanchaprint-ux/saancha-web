---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getUser, supabaseServer } from '../lib/supabase.js';

const user = await getUser(Astro.cookies);
if (!user) return Astro.redirect('/login');

const sb = supabaseServer(Astro.cookies);
const { data: profile } = await sb.from('profiles').select('*').eq('id', user.id).single();
const { data: orders } = await sb.from('orders').select('*').eq('user_id', user.id).order('created_at', { ascending: false });
const { data: quotes } = await sb.from('quote_requests').select('*').eq('user_id', user.id).order('created_at', { ascending: false });
const qlist = quotes || [];
const qStatusColor = { 'submitted':'#E6A15C','under-review':'#E6A15C','quote-ready':'#5FD189','approved':'#5FD189','in-production':'#8FA98C','completed':'#5FD189' };

const name = profile?.full_name || user.email;
const list = orders || [];
const wa = '918800559984';
const statusColor = { pending:'#E6A15C','in-production':'#8FA98C', shipped:'#5FD189', delivered:'#5FD189' };
---
<Base title="My account — Saancha" description="Your Saancha orders.">
  <Nav slot="nav" />
  <main class="account">
    <div class="wrap">
      <div class="acc-head">
        <div>
          <span class="kicker">My account</span>
          <h1>Hello, {name}.</h1>
          <p class="sub">{user.email}</p>
        </div>
        <a href="/logout" class="btn ghost">Log out</a>
      </div>

      <div class="acc-orders">
        <div class="acc-bar"><h2>Your orders</h2><a href={`https://wa.me/${wa}?text=Hi%2C%20I%20want%20to%20place%20an%20order`} target="_blank" rel="noopener" class="btn">New order on WhatsApp</a></div>

        {list.length === 0 ? (
          <div class="empty">
            <p>No orders yet.</p>
            <p class="sub">Once you place an order, it'll show up here with its status.</p>
            <a href="/#materials" class="btn ghost">Browse molds</a>
          </div>
        ) : (
          <div class="otable">
            {list.map(o => (
              <div class="orow">
                <div class="ocol"><span class="mono">Order</span><b>{o.order_no || o.id.slice(0,8)}</b></div>
                <div class="ocol"><span class="mono">Item</span><b>{o.item}</b><span class="meta">{o.material} · qty {o.quantity}</span></div>
                <div class="ocol"><span class="mono">Amount</span><b>{o.amount ? '₹'+o.amount : '—'}</b></div>
                <div class="ocol"><span class="mono">Status</span><span class="badge" style={`color:${statusColor[o.status]||'#E6A15C'};border-color:${statusColor[o.status]||'#E6A15C'}`}>{o.status}</span></div>
                <div class="ocol"><a class="reorder" href={`https://wa.me/${wa}?text=${encodeURIComponent('Hi, I want to reorder: '+o.item)}`} target="_blank" rel="noopener">Reorder →</a></div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="acc-orders" id="requests" style="margin-top:50px">
        <div class="acc-bar"><h2>Custom mould requests</h2><a href="/custom-moulds" class="btn ghost">New custom request</a></div>
        {qlist.length === 0 ? (
          <div class="empty">
            <p>No custom requests yet.</p>
            <p class="sub">Use the calculator on the Custom Moulds page to get an estimate and request a quote.</p>
            <a href="/custom-moulds" class="btn ghost">Custom Moulds</a>
          </div>
        ) : (
          <div class="otable">
            {qlist.map(q => (
              <div class="orow">
                <div class="ocol"><span class="mono">Request</span><b>{q.id.slice(0,8)}</b></div>
                <div class="ocol"><span class="mono">Specs</span><b>{q.product || '—'}</b><span class="meta">{[q.size,q.complexity,(q.logo?'logo':''),q.quantity].filter(Boolean).join(' · ')}</span></div>
                <div class="ocol"><span class="mono">Estimate</span><b>{q.estimate || '—'}</b></div>
                <div class="ocol"><span class="mono">Status</span><span class="badge" style={`color:${qStatusColor[q.status]||'#E6A15C'};border-color:${qStatusColor[q.status]||'#E6A15C'}`}>{q.status}</span></div>
                <div class="ocol"><span class="mono">Date</span><span class="meta">{new Date(q.created_at).toLocaleDateString('en-IN')}</span></div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </main>
  <Footer slot="footer" />
</Base>
