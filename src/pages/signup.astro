---
export const prerender = false; // SSR
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { supabaseAuth } from '../lib/supabase.js';

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = form.get('name')?.toString().trim();
  const email = form.get('email')?.toString().trim();
  const password = form.get('password')?.toString() || '';
  if (!email || password.length < 6) {
    error = 'Enter a valid email and a password of at least 6 characters.';
  } else {
    const sb = supabaseAuth();
    const { data, error: e } = await sb.auth.signUp({
      email, password, options: { data: { full_name: name } },
    });
    if (e) error = e.message;
    else if (data.session) {
      Astro.cookies.set('sb-access-token', data.session.access_token, { path:'/', httpOnly:true, sameSite:'lax', secure:true, maxAge:60*60*24*7 });
      Astro.cookies.set('sb-refresh-token', data.session.refresh_token, { path:'/', httpOnly:true, sameSite:'lax', secure:true, maxAge:60*60*24*30 });
      Astro.cookies.set('sb-auth', '1', { path:'/', sameSite:'lax', secure:true, maxAge:60*60*24*7 });
      return Astro.redirect('/account');
    } else {
      // email confirmation on
      return Astro.redirect('/login?check=1');
    }
  }
}
---
<Base title="Create account — Saancha" description="Create your Saancha account to track orders.">
  <Nav slot="nav" />
  <main class="auth">
    <div class="auth-card">
      <span class="kicker">Create account</span>
      <h1>Join Saancha.</h1>
      <p class="sub">Track your orders and reorder in a click.</p>
      {error && <p class="err">{error}</p>}
      <form method="POST">
        <div class="field"><label class="mono" for="name">Name</label><input id="name" name="name" type="text" required /></div>
        <div class="field"><label class="mono" for="email">Email</label><input id="email" name="email" type="email" required /></div>
        <div class="field"><label class="mono" for="password">Password</label>
          <div class="pass-wrap">
            <input id="password" name="password" type="password" minlength="6" required />
            <button type="button" class="pass-eye" data-eye="password" aria-label="Show password">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <button class="btn" type="submit">Create account</button>
      </form>
      <p class="alt">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </main>
  <Footer slot="footer" />
</Base>
