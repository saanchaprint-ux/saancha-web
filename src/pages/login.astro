---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { createClient } from '@supabase/supabase-js';

let error = '';
const checkEmail = Astro.url.searchParams.get('check') === '1';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = form.get('email')?.toString().trim();
  const password = form.get('password')?.toString() || '';
  const sb = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
  const { data, error: e } = await sb.auth.signInWithPassword({ email, password });
  if (e) error = e.message;
  else if (data.session) {
    Astro.cookies.set('sb-access-token', data.session.access_token, { path:'/', httpOnly:true, sameSite:'lax', secure:true, maxAge:60*60*24*7 });
    Astro.cookies.set('sb-refresh-token', data.session.refresh_token, { path:'/', httpOnly:true, sameSite:'lax', secure:true, maxAge:60*60*24*30 });
    return Astro.redirect('/account');
  }
}
---
<Base title="Log in — Saancha" description="Log in to your Saancha account.">
  <Nav slot="nav" />
  <main class="auth">
    <div class="auth-card">
      <span class="kicker">Welcome back</span>
      <h1>Log in.</h1>
      <p class="sub">Check your orders and reorder.</p>
      {checkEmail && <p class="ok">Account created — please check your email to confirm, then log in.</p>}
      {error && <p class="err">{error}</p>}
      <form method="POST">
        <div class="field"><label class="mono" for="email">Email</label><input id="email" name="email" type="email" required /></div>
        <div class="field"><label class="mono" for="password">Password</label><input id="password" name="password" type="password" required /></div>
        <button class="btn" type="submit">Log in</button>
      </form>
      <p class="alt">New here? <a href="/signup">Create an account</a></p>
    </div>
  </main>
  <Footer slot="footer" />
</Base>
