---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { publishedProducts } from '../lib/catalog.js';
import ProductGrid from '../components/ProductGrid.astro';
import { site } from '../data/site.js';

const { products, error: unavailable } = await publishedProducts();
const categories = ['all','candles','soap','concrete','resin'];
const active = categories.includes(Astro.url.searchParams.get('category')) ? Astro.url.searchParams.get('category') : 'all';
const sort = Astro.url.searchParams.get('sort') || 'new';

let shown = active==='all' ? products : products.filter(p => p.category===active);
if (sort==='low') shown = [...shown].sort((a,b)=>Number(a.price)-Number(b.price));
if (sort==='high') shown = [...shown].sort((a,b)=>Number(b.price)-Number(a.price));

const wa = site.whatsapp;
const HERO = '/images/hf_20261014_020046_1e16f808-7476-4aee-ba0c-d28b6b69a551.webp';
---
<Base title="Shop Silicone Casting Moulds Online | Saancha" description="Browse ready-made silicone casting moulds for candles, soap, concrete and resin. Compare designs, sizes and prices, and enquire directly with Saancha.">
  <Nav slot="nav" />

  <header class="shop-hero2">
    <img class="shop-hero2-bg" src={HERO} alt="Saancha moulds collection" />
    <div class="wrap">
      <div class="crumb mono"><a href="/">Home</a> / Shop</div>
      <h1>Shop <span class="serif-it">moulds.</span></h1>
      <p class="lede">Made for makers. Browse our ready-made collection, or ask us for a custom shape.</p>
    </div>
  </header>

  <!-- trust strip -->
  <div class="shop-trust">
    <div class="wrap">
      <span><b>No</b> minimum order</span>
      <span><b>5–7</b> day builds</span>
      <span><b>Made</b> in Delhi</span>
      <span><b>100s</b> of pulls per mould</span>
    </div>
  </div>

  <main class="readymade" id="shop">
    <div class="wrap">
      <div class="shop-bar saancha-shopbar">
        <nav class="saancha-shopfilters" aria-label="Filter products">
          {categories.map(c => <a class={active===c?'sf-chip on':'sf-chip'} href={c==='all'?'/shop':'/shop?category='+c}>{c==='all'?'All':c}</a>)}
        </nav>
        <form class="shop-sort" method="get">
          {active!=='all' && <input type="hidden" name="category" value={active}>}
          <label class="mono">Sort</label>
          <select name="sort" onchange="this.form.submit()">
            <option value="new" selected={sort==='new'}>Newest</option>
            <option value="low" selected={sort==='low'}>Price: low to high</option>
            <option value="high" selected={sort==='high'}>Price: high to low</option>
          </select>
        </form>
      </div>

      {unavailable
        ? <p class="lede">Shop is temporarily unavailable. Please contact us for the current catalog.</p>
        : shown.length===0
          ? <div class="empty"><p>No products in this category yet.</p><p class="sub">Browse other collections or request a custom mould.</p><a href="/custom-moulds" class="btn ghost">Custom moulds</a></div>
          : <ProductGrid products={shown} />}

      <div class="custombar" style="margin-top:50px">
        <div><h3>Can't find what you need?</h3><p>Every design started as a custom job. Send a sketch, photo or product — we build the mould around it.</p></div>
        <a href="/custom-moulds" class="btn" data-mag>Get a custom quote</a>
      </div>
    </div>
  </main>
  <Footer slot="footer" />
</Base>
