---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { supabaseAuth } from '../../lib/supabase.js';
import { site } from '../../data/site.js';
import { marked } from 'marked';

const { slug } = Astro.params;
let post = null;
try {
  const sb = supabaseAuth();
  const { data } = await sb.from('blog_posts').select('*').eq('slug', slug).eq('published', true).single();
  post = data;
} catch(e) { post = null; }
if (!post) return Astro.redirect('/blog', 302);

const fmt = (d)=> new Date(d).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'});
const readMin = post.read_min || Math.max(2, Math.round((post.body||'').split(/\s+/).length / 200));

// render markdown → HTML (marked). Safe subset; our content only.
marked.setOptions({ breaks: true, gfm: true });
const html = marked.parse(post.body || '');

// related posts (same category)
let related = [];
try {
  const sb = supabaseAuth();
  const { data } = await sb.from('blog_posts').select('slug,title,cover_url,category,published_at')
    .eq('published', true).neq('slug', slug).order('published_at',{ascending:false}).limit(3);
  related = data || [];
} catch(e) { related = []; }

const jsonld = {
  "@context":"https://schema.org","@type":"BlogPosting",
  "headline": post.title, "datePublished": post.published_at,
  "author": {"@type":"Organization","name": post.author||"Saancha"},
  "image": post.cover_url || undefined,
  "mainEntityOfPage": `${site.domain}/blog/${post.slug}`
};
---
<Base title={`${post.title} | Saancha`} description={post.excerpt || post.title} ogImage={post.cover_url} jsonld={jsonld}>
  <Nav slot="nav" />
  <article class="blogpost2">
    <div class="wrap bp2-head">
      <a href="/blog" class="crumb mono bp2-back">← All posts</a>
      <span class="mono bp2-meta"><span class="b2-tag">{post.category||'Guides'}</span> · {fmt(post.published_at)} · {readMin} min read</span>
      <h1>{post.title}</h1>
      {post.excerpt && <p class="bp2-excerpt">{post.excerpt}</p>}
    </div>
    {post.cover_url && <div class="wrap"><div class="bp2-cover"><img src={post.cover_url} alt={post.title} /></div></div>}
    <div class="wrap bp2-wrap">
      <div class="bp2-body" set:html={html}></div>
    </div>

    {related.length>0 && (
      <div class="wrap bp2-related">
        <h2>More from the journal</h2>
        <div class="blog2-grid">
          {related.map(p => (
            <a class="blog2-card" href={`/blog/${p.slug}`}>
              <div class="bc-img">{p.cover_url && <img src={p.cover_url} alt={p.title} loading="lazy" />}<span class="bc-tag">{p.category||'Guides'}</span></div>
              <div class="bc-body"><h3>{p.title}</h3><span class="bc-read">Read →</span></div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="wrap bp2-cta">
      <h3>Need a mould for your product?</h3>
      <a href="/custom-moulds" class="btn" data-mag>Get a custom quote</a>
    </div>
  </article>
  <Footer slot="footer" />
</Base>
