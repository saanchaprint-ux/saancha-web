---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { supabaseAuth } from '../../lib/supabase.js';

let posts = [];
try {
  const sb = supabaseAuth();
  const { data } = await sb.from('blog_posts').select('*')
    .eq('published', true).order('published_at', { ascending:false });
  posts = data || [];
} catch(e) { posts = []; }

const fmt = (d)=> new Date(d).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
---
<Base title="Blog — Saancha" description="Guides and ideas on casting moulds — candles, soap, resin, concrete. Tips from the Saancha workshop in Delhi.">
  <Nav slot="nav" />
  <header class="sec" style="padding-top:140px;padding-bottom:40px">
    <div class="wrap">
      <span class="kicker rvu" style="display:block;margin-bottom:16px">Journal</span>
      <h1 class="rvu" style="font-size:clamp(2.4rem,6vw,4.4rem);max-width:16ch">Notes from the <span class="serif-it">workshop.</span></h1>
      <p class="lede rvu" style="margin-top:16px">Guides, comparisons and ideas on casting moulds — straight from the people who make them.</p>
    </div>
  </header>

  <section class="sec" style="padding-top:20px">
    <div class="wrap">
      {posts.length===0 ? (
        <div class="empty"><p>No posts yet.</p><p class="sub">New articles are on the way.</p></div>
      ) : (
        <div class="blog-grid">
          {posts.map(p => (
            <a class="blog-card rvu" href={`/blog/${p.slug}`}>
              <div class="bc-img">{p.cover_url && <img src={p.cover_url} alt={p.title} loading="lazy" />}</div>
              <div class="bc-body">
                <span class="mono bc-date">{fmt(p.published_at)}</span>
                <h2>{p.title}</h2>
                {p.excerpt && <p>{p.excerpt}</p>}
                <span class="bc-read">Read →</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  <Footer slot="footer" />
</Base>
