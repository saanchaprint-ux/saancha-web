---
export const prerender = false;
import { isAdmin } from '../../lib/admin.js';
if(!isAdmin(Astro.cookies)) return Astro.redirect('/admin/login');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Saancha Studio | Visual Editor</title><style>
:root{color-scheme:dark;font-family:Inter,system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:#0d0e10;color:#f5f3ef}header{height:66px;border-bottom:1px solid #323235;display:flex;align-items:center;gap:14px;padding:0 22px}header b{font-family:Georgia,serif;font-size:24px}button,select,input,textarea{font:inherit}button,a.ctrl,select{background:#242428;border:1px solid #404045;color:#fff;border-radius:9px;padding:10px 12px;text-decoration:none;cursor:pointer}button:hover{border-color:#e8a15d}button.primary{background:#e6a15c;color:#17110d;border:0;font-weight:700}button:disabled{opacity:.5;cursor:not-allowed}select{max-width:195px}.spacer{flex:1}.layout{height:calc(100dvh - 66px);display:flex}.side{width:315px;flex:none;border-right:1px solid #313135;padding:20px;overflow:auto}.side h2{font-family:Georgia,serif;font-size:26px;margin:0 0 7px}.hint{color:#a8a6aa;font-size:13px;line-height:1.6}.label{display:block;margin:20px 0 7px;color:#c4c1c4;font-size:13px}textarea,input{width:100%;background:#17171a;border:1px solid #3b3b40;color:white;padding:11px;border-radius:7px}textarea{min-height:140px;resize:vertical}.canvas{flex:1;overflow:auto;background:#222326;display:flex;justify-content:center;padding:22px}.canvas iframe{height:100%;width:100%;border:0;background:white;box-shadow:0 14px 60px #0006;transition:width .2s}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.notice{font-size:13px;color:#e9a15f;min-height:20px}.nav{display:flex;gap:7px;flex-wrap:wrap;margin-top:24px}.nav a{font-size:13px;color:#dad8d5;text-decoration:none;border:1px solid #434348;border-radius:8px;padding:9px}.muted{color:#888}.selected{word-break:break-all;background:#1b1c1f;padding:10px;border-radius:8px;font-size:12px}#imagePreview{width:100%;border-radius:8px;max-height:140px;object-fit:contain;display:none} @media(max-width:850px){.side{width:235px}header{flex-wrap:wrap;height:auto;min-height:66px}.layout{height:calc(100dvh - 120px)}}
</style></head><body>
<header><b>Saancha Studio</b><select aria-label="Select page" id="page"><option value="/">Home</option><option value="/shop">Shop</option><option value="/candles">Candles</option><option value="/soap">Soap</option><option value="/concrete">Concrete</option><option value="/resin">Resin</option><option value="/custom-moulds">Custom moulds</option></select><button data-width="100%">Desktop</button><button data-width="768px">Tablet</button><button data-width="390px">Mobile</button><div class="spacer"></div><a class="ctrl" href="/admin/products">Products & SKUs</a><a class="ctrl" href="/admin/media">Media</a><button id="discard">Discard drafts</button><button class="primary" id="publish">Publish page</button></header>
<div class="layout"><aside class="side"><h2>Edit visually</h2><p class="hint">Click any text, image or link in the actual website preview. Edit in this panel, save a draft, then publish when ready.</p><div class="label">Selected element</div><div class="selected" id="selected">Nothing selected yet</div><label class="label" id="valueLabel" for="value">Content</label><textarea id="value" disabled placeholder="Click an element in the website preview"></textarea><img id="imagePreview" alt="Selected image preview"/><div class="actions"><button id="save" disabled>Save draft & preview</button></div><p class="notice" role="status" id="notice"></p><div class="nav"><a href="/admin">Dashboard</a><a href="/admin/blocks">Advanced sections</a><a href="/shop" target="_blank" rel="noopener">Open shop ↗</a></div><p class="hint">Published products appear automatically in Shop and their material category. Existing site design is preserved unless edited. Complex nested layouts and drag-and-drop are not supported in this version.</p></aside><main class="canvas"><iframe title="Live Saancha webpage" id="preview"></iframe></main></div>
<script is:inline>
(()=>{const page=document.querySelector('#page'),frame=document.querySelector('#preview'),area=document.querySelector('#value'),save=document.querySelector('#save'),selected=document.querySelector('#selected'),notice=document.querySelector('#notice'),label=document.querySelector('#valueLabel'),img=document.querySelector('#imagePreview');let current=null;const status=t=>notice.textContent=t;
const load=()=>{current=null;selected.textContent='Nothing selected yet';area.value='';area.disabled=save.disabled=true;frame.src=page.value+(page.value.includes('?')?'&':'?')+'studio=1';status('')};page.addEventListener('change',load);load();
document.querySelectorAll('[data-width]').forEach(btn=>btn.addEventListener('click',()=>{frame.style.width=btn.dataset.width}));
window.addEventListener('message',e=>{if(e.origin!==location.origin||e.source!==frame.contentWindow||!e.data)return;if(e.data.studio==='selected'){current=e.data;selected.textContent=e.data.tag+' · '+e.data.selector;area.value=e.data.value;area.disabled=save.disabled=false;label.textContent=e.data.property==='src'?'Image URL':e.data.property==='href'?'Link address':'Text content';img.style.display=e.data.property==='src'?'block':'none';if(e.data.property==='src')img.src=e.data.value;} });
async function call(payload){status('Working…');try{const res=await fetch('/api/studio',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...payload,page:page.value})});const data=await res.json();if(!res.ok)throw Error(data.error||'Failed');return true}catch(err){status(err.message+' (check Supabase migration)');return false}}
save.addEventListener('click',async()=>{if(!current)return;const value=area.value;const ok=await call({action:'draft',selector:current.selector,property:current.property,value});if(ok){frame.contentWindow.postMessage({studio:'update',row:{selector:current.selector,property:current.property,value}},location.origin);status('Draft saved. Click Publish page to make it live.')}});
document.querySelector('#publish').addEventListener('click',async()=>{if(await call({action:'publish'})){status('Page published successfully.');frame.contentWindow.location.reload()}});
document.querySelector('#discard').addEventListener('click',async()=>{if(confirm('Discard unpublished changes on this page?')&&await call({action:'discard'})){load();status('Draft changes discarded.')}});
})();
</script></body></html>