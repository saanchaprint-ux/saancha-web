---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { isAdmin, supabaseAdmin } from '../../lib/admin.js';
import { compressImage } from '../../lib/imgcompress.js';
if (!isAdmin(Astro.cookies)) return Astro.redirect('/admin/login');
const sb = supabaseAdmin();
let notice = '';
const str=(f,k)=>String(f.get(k)||'').trim();
const categories=['candles','soap','concrete','resin'];
const slugify=(s)=>String(s||'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'');
// normalize images: supports old ["url"] and new [{url,alt}]
const normImgs=(arr)=> (Array.isArray(arr)?arr:[]).map(x=> typeof x==='string'?{url:x,alt:''}:{url:x?.url||'',alt:x?.alt||''}).filter(x=>x.url);
// upload a square product image, return URL (or '')
async function uploadSquare(file){
  if(!file||!file.size) return '';
  const { buffer, contentType, ext } = await compressImage(file, { maxWidth:1200, quality:82, square:true });
  const path=`product-${Date.now()}-${Math.random().toString(36).slice(2,7)}.${ext}`;
  const { error }=await sb.storage.from('site-images').upload(path, buffer, { contentType, upsert:true });
  if(error) return '';
  return sb.storage.from('site-images').getPublicUrl(path).data.publicUrl;
}
// unique SKU generator (SAAN-<cat3>-<rand>)
async function genSku(category){
  const pre=(category||'prd').slice(0,3).toUpperCase();
  for(let t=0;t<6;t++){
    const sku=`SAAN-${pre}-${Math.random().toString(36).slice(2,6).toUpperCase()}`;
    const {data}=await sb.from('cms_products').select('id').eq('base_sku',sku).maybeSingle();
    if(!data) return sku;
  }
  return `SAAN-${pre}-${Date.now().toString(36).toUpperCase().slice(-5)}`;
}
async function uniqueSlug(base, selfId){
  let slug=slugify(base)||'product'; let s=slug; let n=1;
  while(true){
    const {data}=await sb.from('cms_products').select('id').eq('slug',s).maybeSingle();
    if(!data || data.id===selfId) return s;
    s=`${slug}-${++n}`;
  }
}
if (Astro.request.method==='POST') {
 const f=await Astro.request.formData(); const action=str(f,'action'); const id=str(f,'id');
 if (action==='publish' && id) { const {error}=await sb.from('cms_products').update({status:'published',updated_at:new Date().toISOString()}).eq('id',id); notice=error?'Error: '+error.message:'Product published. Open /shop to view it.'; }
 if (action==='unpublish' && id) { const {error}=await sb.from('cms_products').update({status:'draft',updated_at:new Date().toISOString()}).eq('id',id); notice=error?'Error: '+error.message:'Product unpublished.'; }
 if (action==='save') {
  let existing=null; if(id){ const {data}=await sb.from('cms_products').select('*').eq('id',id).single(); existing=data; }
  const name=str(f,'name');
  const oldImgs = normImgs(existing?.images);

  // image order comes from hidden field "img_order" = comma list of slot indices (drag-reorder)
  // each slot: existing image at that index (keep) OR a new uploaded file "img<idx>"
  const orderRaw = str(f,'img_order');
  const order = orderRaw ? orderRaw.split(',').map(x=>parseInt(x)).filter(n=>!isNaN(n)) : [0,1,2,3];
  const altFor=(idx)=> str(f,'alt'+idx);
  const built=[];
  for(const idx of order){
    const file=f.get('img'+idx);
    let url='';
    if(file && file.size) url=await uploadSquare(file);
    else url = oldImgs[idx]?.url || '';
    if(!url) continue;
    // alt: manual if given, else auto from product name + position
    let alt=altFor(idx) || oldImgs[idx]?.alt || '';
    if(!alt){ const pos=built.length+1; alt = pos===1 ? `${name} — ${str(f,'category')} mould` : `${name} — photo ${pos}`; }
    built.push({url, alt});
  }

  const bulk=[];
  for(let i=0;i<5;i++){ const q=Number(str(f,'qty'+i)), p=Number(str(f,'bprice'+i)); if(q>0 && p>0) bulk.push({qty:q, price:p}); }
  bulk.sort((a,b)=>a.qty-b.qty);

  // auto slug + sku (editable: use given if present, else generate)
  let slug=str(f,'slug'); if(!slug) slug=await uniqueSlug(name, id||null); else slug=await uniqueSlug(slug, id||null);
  let sku=str(f,'base_sku').toUpperCase(); if(!sku) sku=await genSku(str(f,'category'));

  const row={name, slug, category:str(f,'category'), base_sku:sku, description:str(f,'description'), dimensions:str(f,'dimensions')||null,
    image_url: built[0]?.url || '', images: built, bulk_tiers:bulk,
    price:Number(str(f,'price')||0), stock:Number(str(f,'stock')||0), status:str(f,'status'), sort:Number(str(f,'sort')||100), updated_at:new Date().toISOString()};
  if (!row.name || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(row.slug) || !/^[A-Z0-9_-]+$/.test(row.base_sku) || !categories.includes(row.category) || !['draft','published','archived'].includes(row.status) || !Number.isInteger(row.stock) || row.stock<0 || !Number.isFinite(row.price) || row.price<0) notice='Error: Invalid product fields.';
  else { if(id && existing) { await sb.from('cms_revisions').insert({entity:'product',entity_id:id,snapshot:existing}); }
   const {error}=id ? await sb.from('cms_products').update(row).eq('id',id) : await sb.from('cms_products').insert(row);
   notice=error?'Error: '+error.message:'Product saved.'; }
 }
 if (action==='delete' && id) { const {error}=await sb.from('cms_products').delete().eq('id',id);notice=error?'Error: '+error.message:'Product deleted.'; }
 if(action==='variant' && id){const row={product_id:id,label:str(f,'label'),sku:str(f,'sku').toUpperCase(),price:Number(str(f,'price')),stock:Number(str(f,'stock'))};
  if(!row.label || !/^[A-Z0-9_-]+$/.test(row.sku) || !Number.isFinite(row.price) || row.price<0 || !Number.isInteger(row.stock) || row.stock<0) notice='Error: Invalid variant.';
  else {const {error}=await sb.from('cms_product_variants').insert(row);notice=error?'Error: '+error.message:'Variant added.';}}
 if(action==='delete-variant' && id){const {error}=await sb.from('cms_product_variants').delete().eq('id',id);notice=error?'Error: '+error.message:'Variant deleted.';}
}
const {data:products,error:loadError}=await sb.from('cms_products').select('*').order('sort').order('created_at',{ascending:false});
const {data:variants}=await sb.from('cms_product_variants').select('*').order('created_at');
const edit=(products||[]).find(p=>p.id===Astro.url.searchParams.get('edit'));
---
<Base title="Product manager — Saancha Studio"><main class="admin"><div class="wrap">
 <div class="admin-head"><div><span class="kicker">Saancha Studio</span><h1>Products & SKUs</h1></div><a class="btn ghost" href="/admin">Dashboard</a></div>
 <nav class="admin-nav"><a href="/admin/studio" style="border-color:#e9a65e;color:#e9a65e">✦ Visual Studio</a><a href="/admin">Orders</a><a href="/admin/content">Content</a><a href="/admin/blocks">Sections</a><a href="/admin/products" class="on">Products</a><a href="/admin/media">Media</a><a href="/admin/settings">Settings</a></nav>
 {loadError && <p class="err">Database upgrade required: {loadError.message}. Run db/cms-upgrade.sql.</p>}
 {notice && <p class={notice.startsWith('Error')?'err':'ok'}>{notice}</p>}
 <p class="shop-helper">Products become visible on <a href="/shop" target="_blank" rel="noopener">Shop ↗</a> and their material pages when their status is <strong>Published</strong>. Drafts stay hidden. New items appear without rebuilding the website.</p><section class="admin-card"><h2>{edit?'Edit product':'Add product'}</h2><form method="POST" class="admin-form" enctype="multipart/form-data">
 <input type="hidden" name="action" value="save"/><input type="hidden" name="id" value={edit?.id||''}/>
 <div class="ag"><label>Name<input name="name" required value={edit?.name||''}/></label><label>Slug (auto se naam se — khaali chhodo)<input name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="auto-generate" value={edit?.slug||''}/></label></div>
 <div class="ag"><label>Category<select name="category">{categories.map(x=><option selected={edit?.category===x} value={x}>{x}</option>)}</select></label><label>SKU (auto — khaali chhodo)<input name="base_sku" placeholder="auto-generate" value={edit?.base_sku||''}/></label><label>Dimensions<input name="dimensions" placeholder="e.g. 3 × 3 × 4 in" value={edit?.dimensions||''}/></label></div>
 <label>Description<textarea name="description" rows="3">{edit?.description||''}</textarea></label>

 <div class="prod-images" id="prodImages">
   <label style="margin-bottom:8px;display:block">Product photos — drag to reorder. First = main photo. Square auto-crop.</label>
   <input type="hidden" name="img_order" id="imgOrder" value="0,1,2,3"/>
   <div class="prod-img-row" id="imgRow">
     {[0,1,2,3].map(i=>{ const im=edit?.images?.[i]; const url=typeof im==='string'?im:im?.url; const alt=typeof im==='object'?(im?.alt||''):''; return (
       <div class="prod-img-slot" draggable="true" data-idx={i}>
         <div class="drag-handle mono">⠿ drag</div>
         {url && <img src={url} alt={alt||`Photo ${i+1}`} />}
         <input type="file" name={`img${i}`} accept="image/*"/>
         <input type="text" name={`alt${i}`} placeholder="Alt text (auto if empty)" value={alt} class="alt-input"/>
         <span class="mono slot-pos">Photo {i+1}</span>
       </div>
     )})}
   </div>
   <p class="mono" style="color:var(--fg-45)">Drag tiles to reorder. Khaali slot = purani photo rahegi. Alt khaali = auto (product naam se).</p>
 </div>

 <div class="ag"><label>Single price (₹)<input type="number" min="0" step="0.01" name="price" required value={edit?.price??0}/></label><label>Stock<input type="number" min="0" step="1" name="stock" required value={edit?.stock??0}/></label><label>Sort<input type="number" name="sort" value={edit?.sort??100}/></label></div>

 <div class="bulk-tiers">
   <label style="margin-bottom:8px;display:block">Bulk pricing (per unit at quantity) — up to 5 tiers, flexible</label>
   {[0,1,2,3,4].map(i=>{ const t=edit?.bulk_tiers?.[i]; return (
     <div class="ag bulk-row">
       <label>Qty<input type="number" min="1" name={`qty${i}`} placeholder={i===0?'10':''} value={t?.qty||''}/></label>
       <label>Price/unit (₹)<input type="number" min="0" step="0.01" name={`bprice${i}`} value={t?.price||''}/></label>
     </div>
   )})}
   <p class="mono" style="color:var(--fg-45)">Example: Qty 10 → ₹850, Qty 50 → ₹720. Khaali rows ignore honge.</p>
 </div>

 <label>Status<select name="status">{['draft','published','archived'].map(x=><option value={x} selected={(edit?.status||'draft')===x}>{x}</option>)}</select></label>
 <button class="btn">{edit?'Save changes':'Create product'}</button>{edit && <a class="mini-btn" href="/admin/products">Cancel edit</a>}
 </form></section>
 <section class="admin-card"><h2>Catalog ({products?.length||0})</h2>{(products||[]).map(p=><div class="blk-item"><div><b>{p.name}</b><span>{p.base_sku} · {p.category} · ₹{p.price} · Stock {p.stock} · {p.status}</span></div><div class="blk-item-actions"><a class="mini-btn" href={`/admin/products?edit=${p.id}`}>Edit</a>{p.status!=='published' ? <form method="POST"><input type="hidden" name="action" value="publish"/><input type="hidden" name="id" value={p.id}/><button class="mini-btn">Publish to Shop</button></form> : <><a class="mini-btn" href="/shop" target="_blank" rel="noopener">View Shop ↗</a><form method="POST"><input type="hidden" name="action" value="unpublish"/><input type="hidden" name="id" value={p.id}/><button class="mini-btn">Unpublish</button></form></>}<form method="POST" onsubmit="return confirm('Delete product and its variants?')"><input type="hidden" name="action" value="delete"/><input type="hidden" name="id" value={p.id}/><button class="mini-btn danger">Delete</button></form></div></div>)}</section>
 {edit && <section class="admin-card"><h2>Variants for {edit.name}</h2>{(variants||[]).filter(v=>v.product_id===edit.id).map(v=><div class="blk-item"><div><b>{v.label}</b><span>{v.sku} · ₹{v.price} · Stock {v.stock}</span></div><form method="POST" onsubmit="return confirm('Delete variant?')"><input type="hidden" name="action" value="delete-variant"/><input type="hidden" name="id" value={v.id}/><button class="mini-btn danger">Delete</button></form></div>)}<form class="admin-form" method="POST"><input type="hidden" name="action" value="variant"/><input type="hidden" name="id" value={edit.id}/><div class="ag"><label>Variant label<input name="label" required placeholder="Large / Blue"/></label><label>SKU<input name="sku" required/></label><label>Price<input name="price" type="number" min="0" step=".01" required/></label><label>Stock<input name="stock" type="number" min="0" value="0" required/></label></div><button class="btn">Add variant</button></form></section>}
 </div></main>
<script is:inline>
(function(){
  const row=document.getElementById('imgRow');
  const orderInput=document.getElementById('imgOrder');
  if(!row||!orderInput) return;
  let dragEl=null;
  function updateOrder(){
    const idxs=[...row.children].map(s=>s.dataset.idx);
    orderInput.value=idxs.join(',');
    // update position labels
    [...row.children].forEach((s,i)=>{ const pos=s.querySelector('.slot-pos'); if(pos) pos.textContent='Photo '+(i+1)+(i===0?' (main)':''); });
  }
  row.querySelectorAll('.prod-img-slot').forEach(slot=>{
    slot.addEventListener('dragstart',e=>{ dragEl=slot; slot.classList.add('dragging'); });
    slot.addEventListener('dragend',e=>{ slot.classList.remove('dragging'); updateOrder(); });
    slot.addEventListener('dragover',e=>{
      e.preventDefault();
      const after=[...row.querySelectorAll('.prod-img-slot:not(.dragging)')].find(s=>{
        const r=s.getBoundingClientRect(); return e.clientX < r.left + r.width/2;
      });
      if(after) row.insertBefore(dragEl, after); else row.appendChild(dragEl);
    });
  });
  updateOrder();
})();
</script>
</Base>

<style>.shop-helper{padding:16px 20px;background:#191712;border:1px solid #6d4a2a;border-radius:12px;color:#e9d1b5;margin:20px 0}.shop-helper a{color:#eaaa65;text-decoration:underline}.blk-item-actions{flex-wrap:wrap}</style>
