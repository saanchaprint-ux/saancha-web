---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { isAdmin, supabaseAdmin, clearAdminCookie } from '../../lib/admin.js';
if (!isAdmin(Astro.cookies)) return Astro.redirect('/admin/login');

const sb = supabaseAdmin();
let notice = '';
const slugify = (s)=> s.toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');

async function uploadImg(file){
  if(!file||!file.size) return '';
  const ext=(file.name.split('.').pop()||'jpg').toLowerCase();
  const path=`blog-${Date.now()}.${ext}`;
  const buf=new Uint8Array(await file.arrayBuffer());
  const { error }=await sb.storage.from('site-images').upload(path,buf,{contentType:file.type,upsert:true});
  if(error) return '';
  return sb.storage.from('site-images').getPublicUrl(path).data.publicUrl;
}

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = f.get('action')?.toString();
  if (action==='logout'){ clearAdminCookie(Astro.cookies); return Astro.redirect('/admin/login'); }

  if (action==='add' || action==='edit') {
    const title=f.get('title')?.toString().trim();
    let slug=f.get('slug')?.toString().trim(); if(!slug) slug=slugify(title||'post');
    const row={ title, slug,
      excerpt:f.get('excerpt')?.toString().trim()||null,
      body:f.get('body')?.toString()||null,
      category:f.get('category')?.toString().trim()||'Guides',
      read_min: f.get('read_min') ? parseInt(f.get('read_min').toString()) : null,
      published: f.get('published')==='on',
    };
    const cover=await uploadImg(f.get('cover'));
    if(cover) row.cover_url=cover;
    if (action==='add'){
      const { error }=await sb.from('blog_posts').insert(row);
      notice= error?('Error: '+error.message):'Post added.';
    } else {
      const id=f.get('id')?.toString();
      const { error }=await sb.from('blog_posts').update(row).eq('id',id);
      notice= error?('Error: '+error.message):'Post updated.';
    }
  }
  if (action==='del'){ await sb.from('blog_posts').delete().eq('id',f.get('id')?.toString()); notice='Post deleted.'; }
  if (action==='toggle'){ const id=f.get('id')?.toString(); const p=f.get('published')==='true'; await sb.from('blog_posts').update({published:!p}).eq('id',id); notice='Updated.'; }
}

const editId = Astro.url.searchParams.get('edit');
let editing=null;
if (editId){ const {data}=await sb.from('blog_posts').select('*').eq('id',editId).single(); editing=data; }
const { data } = await sb.from('blog_posts').select('*').order('published_at',{ascending:false});
const list = data||[];
---
<Base title="Admin — Blog — Saancha">
  <main class="admin">
    <div class="wrap">
      <div class="admin-head"><div><span class="kicker">Saancha Admin</span><h1>Blog</h1></div>
        <form method="POST"><input type="hidden" name="action" value="logout"><button class="btn ghost">Log out</button></form></div>
      <nav class="admin-nav">
        <a href="/admin">Orders</a><a href="/admin/quotes">Quotes</a><a href="/admin/leads">Leads</a><a href="/admin/blog" class="on">Blog</a><a href="/admin/testimonials">Testimonials</a><a href="/admin/promo">Promo</a><a href="/admin/pricing">Pricing</a><a href="/admin/content">Content</a><a href="/admin/blocks">Sections</a>
      </nav>
      {notice && <p class={notice.startsWith('Error')?'err':'ok'}>{notice}</p>}

      <section class="admin-card">
        <h2>{editing?'Edit post':'Add a post'}</h2>
        <form method="POST" enctype="multipart/form-data" class="admin-form">
          <input type="hidden" name="action" value={editing?'edit':'add'}>
          {editing && <input type="hidden" name="id" value={editing.id}>}
          <div class="ag">
            <label>Title <input name="title" value={editing?.title||''} required></label>
            <label>Slug (URL, optional) <input name="slug" value={editing?.slug||''} placeholder="auto from title"></label>
          </div>
          <label>Excerpt (short summary for cards) <input name="excerpt" value={editing?.excerpt||''}></label>
          <div class="ag">
            <label>Category <input name="category" value={editing?.category||'Guides'} placeholder="Guides"></label>
            <label>Read time (min, optional) <input name="read_min" type="number" value={editing?.read_min||''} placeholder="auto"></label>
          </div>
          <label>Body
            <div class="md-editor">
              <div class="md-toolbar">
                <button type="button" data-md="h2">H2</button>
                <button type="button" data-md="h3">H3</button>
                <button type="button" data-md="bold"><b>B</b></button>
                <button type="button" data-md="italic"><i>I</i></button>
                <button type="button" data-md="ul">• List</button>
                <button type="button" data-md="ol">1. List</button>
                <button type="button" data-md="quote">❝ Quote</button>
                <button type="button" data-md="link">🔗 Link</button>
                <button type="button" data-md="img">🖼 Image</button>
                <span class="md-spacer"></span>
                <button type="button" id="mdPreviewToggle" class="md-prev-btn">Preview</button>
              </div>
              <div class="md-panes">
                <textarea name="body" id="mdBody" rows="16" spellcheck="true">{editing?.body||''}</textarea>
                <div class="md-preview" id="mdPreview" hidden></div>
              </div>
              <p class="md-hint">Markdown supported — use the buttons or type. Blank line = new paragraph. Image button uploads &amp; inserts.</p>
            </div>
          </label>
          <!-- hidden file input for image uploads inside body -->
          <input type="file" id="mdImgFile" accept="image/*" style="display:none">
          <input type="hidden" name="body_images" id="mdBodyImages">
          <div class="ag">
            <label>Cover image {editing?.cover_url && <span class="mono" style="color:var(--fg-45)">(current set)</span>}<input type="file" name="cover" accept="image/*"></label>
            <label style="flex-direction:row;align-items:center;gap:8px;margin-top:22px"><input type="checkbox" name="published" style="width:auto" checked={editing?.published}> Published</label>
          </div>
          <div style="display:flex;gap:10px">
            <button class="btn" type="submit">{editing?'Update post':'Add post'}</button>
            {editing && <a href="/admin/blog" class="btn ghost">Cancel</a>}
          </div>
        </form>
      </section>

      <section class="admin-card">
        <h2>All posts ({list.length})</h2>
        <div class="atable">
          {list.map(p => (
            <div class="arow">
              <div><b>{p.title}</b><span>/{p.slug}</span></div>
              <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <span class="badge" style={`color:${p.published?'#5FD189':'#E6A15C'};border-color:${p.published?'#5FD189':'#E6A15C'}`}>{p.published?'live':'draft'}</span>
                <a class="mini-btn" href={`/admin/blog?edit=${p.id}`}>Edit</a>
                <form method="POST"><input type="hidden" name="action" value="toggle"><input type="hidden" name="id" value={p.id}><input type="hidden" name="published" value={String(p.published)}><button class="mini-btn">{p.published?'Unpublish':'Publish'}</button></form>
                <form method="POST" onsubmit="return confirm('Delete this post?')"><input type="hidden" name="action" value="del"><input type="hidden" name="id" value={p.id}><button class="mini-btn danger">Delete</button></form>
              </div>
            </div>
          ))}
          {list.length===0 && <p style="color:var(--fg-45)">No posts yet.</p>}
        </div>
      </section>
    </div>
  </main>

  <script type="module" is:inline>
    import { marked } from 'https://esm.sh/marked@18';
    const ta = document.getElementById('mdBody');
    const prev = document.getElementById('mdPreview');
    const toggle = document.getElementById('mdPreviewToggle');
    const imgInput = document.getElementById('mdImgFile');
    if (ta) {
      // wrap selection / insert markdown
      function surround(before, after=''){
        const s=ta.selectionStart, e=ta.selectionEnd, v=ta.value;
        const sel=v.slice(s,e);
        ta.value = v.slice(0,s)+before+sel+after+v.slice(e);
        ta.focus(); ta.selectionStart=s+before.length; ta.selectionEnd=s+before.length+sel.length;
        renderPrev();
      }
      function linePrefix(pfx){
        const s=ta.selectionStart, v=ta.value;
        const lineStart=v.lastIndexOf('\n',s-1)+1;
        ta.value=v.slice(0,lineStart)+pfx+v.slice(lineStart);
        ta.focus(); renderPrev();
      }
      document.querySelectorAll('.md-toolbar button[data-md]').forEach(b=>{
        b.addEventListener('click', ()=>{
          const t=b.dataset.md;
          if(t==='bold') surround('**','**');
          else if(t==='italic') surround('*','*');
          else if(t==='h2') linePrefix('## ');
          else if(t==='h3') linePrefix('### ');
          else if(t==='ul') linePrefix('- ');
          else if(t==='ol') linePrefix('1. ');
          else if(t==='quote') linePrefix('> ');
          else if(t==='link'){ const u=prompt('Link URL:'); if(u) surround('[', `](${u})`); }
          else if(t==='img'){ imgInput.click(); }
        });
      });
      // image upload
      imgInput && imgInput.addEventListener('change', async ()=>{
        const f=imgInput.files[0]; if(!f) return;
        const fd=new FormData(); fd.append('file', f);
        const btn=document.querySelector('[data-md="img"]'); const old=btn.textContent; btn.textContent='Uploading…';
        try{
          const r=await fetch('/api/upload',{method:'POST',body:fd});
          const j=await r.json();
          if(j.url){ const s=ta.selectionStart, v=ta.value; const ins=`\n\n![image](${j.url})\n\n`; ta.value=v.slice(0,s)+ins+v.slice(s); renderPrev(); }
          else alert('Upload failed: '+(j.error||'')); 
        }catch(e){ alert('Upload failed'); }
        btn.textContent=old; imgInput.value='';
      });
      // live preview
      function renderPrev(){ prev.innerHTML = marked.parse(ta.value||''); }
      toggle && toggle.addEventListener('click', ()=>{
        const on = prev.hasAttribute('hidden');
        if(on){ renderPrev(); prev.hidden=false; ta.closest('.md-panes').classList.add('split'); toggle.classList.add('on'); toggle.textContent='Editing'; }
        else { prev.hidden=true; ta.closest('.md-panes').classList.remove('split'); toggle.classList.remove('on'); toggle.textContent='Preview'; }
      });
      ta.addEventListener('input', ()=>{ if(!prev.hidden) renderPrev(); });
    }
  </script>
</Base>
