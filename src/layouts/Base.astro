---
import '../styles/global.css';
import { site } from '../data/site.js';
import { supabaseAdmin, isAdmin } from '../lib/admin.js';
const {
  title = `${site.name} — Casting Molds, Made in ${site.city}`,
  description = `${site.name} designs and manufactures casting molds in Delhi — candles, soap, resin, concrete. No minimum order, 5–7 day turnaround.`,
  ogImage = '',
  jsonld = null,
  robots = null,
} = Astro.props;
const studioPreview = Astro.url.searchParams.get('studio') === '1' && isAdmin(Astro.cookies);
const cmsPage = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
let visualEdits = [];
try {
 const {data,error} = await supabaseAdmin().from('cms_visual_edits').select('selector,property,draft_value,published_value').eq('page',cmsPage);
 if(!error) visualEdits = (data||[]).map(row=>({selector:row.selector,property:row.property,value:studioPreview && row.draft_value!==null?row.draft_value:row.published_value})).filter(row=>row.value!==null);
} catch {}
const canonical = new URL(Astro.url.pathname, site.domain).href;
const privatePath = /^\/(admin(?:\/|$)|api(?:\/|$)|account(?:\/|$)|login\/?$|logout\/?$|signup\/?$|forgot\/?$|reset\/?$)/.test(Astro.url.pathname);
const robotsValue = robots ?? (privatePath ? 'noindex, nofollow, noarchive' : 'index, follow, max-image-preview:large');
// These IDs belong to the owner and must be added in Vercel's environment settings.
const gscVerification = import.meta.env.GOOGLE_SITE_VERIFICATION || '';
// GA4 measurement IDs are public. Fallback ensures analytics also renders on static/pre-rendered pages.
const gaMeasurementId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-PMYYSHZM0B').trim();
const fallbackOgImage = 'https://d8j0ntlcm91z4.cloudfront.net/user_39EURzFKi2WVselNBK2rRVHKRD5/hf_20261014_015056_7b005b45-f5a1-4c3b-a0e8-671dd40f27b4.png';
const fullOgImage = ogImage ? new URL(ogImage, site.domain).href : fallbackOgImage;
const safeJsonld = jsonld ? JSON.stringify(jsonld).replace(/</g,'\\u003c') : '';

---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsValue} />
  {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" set:html={safeJsonld} />}
  {gaMeasurementId && !privatePath && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`}></script>}
  {gaMeasurementId && !privatePath && <script is:inline set:html={`
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', ${JSON.stringify(gaMeasurementId)});
  `} />}
</head>
<body>
  <!-- logo mark (shared) -->
  <svg style="display:none" aria-hidden="true">
    <symbol id="mark" viewBox="0 0 100 128">
      <path d="M50 30 C50 30 33 30 27 20 C21 10 30 4 30 4 C30 4 44 8 48 18 C50 23 50 30 50 30Z" fill="currentColor" opacity=".9"/>
      <path d="M50 34 L50 22" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" fill="none"/>
      <path d="M50 34 L84 54 L84 94 L50 114 L16 94 L16 54 Z" fill="none" stroke="currentColor" stroke-width="5.5" stroke-linejoin="round"/>
      <path d="M50 34 L50 74 M50 74 L16 54 M50 74 L84 54" fill="none" stroke="currentColor" stroke-width="5.5" stroke-linejoin="round" stroke-linecap="round" opacity=".55"/>
    </symbol>
  </svg>

  <div id="cur"></div><div id="curR"><b></b></div>
  <div class="prog" id="prog"></div>

  <slot name="nav" />
  <slot />
  <slot name="footer" />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
  <script id="saancha-visual-data" type="application/json" set:html={JSON.stringify(visualEdits).replace(/</g,'\\u003c')} />
  <script src="/visual-runtime.js" is:inline></script>
  {studioPreview && <script src="/studio-frame.js" is:inline></script>}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
  <script src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js" is:inline></script>
  <script src="/site.js" is:inline></script>
</body>
</html>
