---
import { site, materials } from '../data/site.js';
---
<footer>
  <div class="wrap">
    <div class="f-top">
      <div class="f-brand">
        <img src="/logo.png" alt={site.name} class="brand-logo-f" />
        <p>Casting molds designed and manufactured in {site.city}. {site.tagline}.</p>
      </div>
      <div class="f-col">
        <h4>Materials</h4>
        {materials.map(m => <a href={`/${m.slug}`}>{m.label}</a>)}
      </div>
      <div class="f-col">
        <h4>Contact</h4>
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp us</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href="/#contact">Send an enquiry</a>
      </div>
    </div>
    <div class="f-bot">
      <span class="mono">&copy; <span id="yr"></span> {site.name}</span>
      <span class="mono">{site.city}</span>
    </div>
  </div>
</footer>

<a href={`https://wa.me/${site.whatsapp}?text=Hi%2C%20I%20need%20a%20mold`} class="fab" target="_blank" rel="noopener" aria-label="WhatsApp">
  <svg viewBox="0 0 24 24"><path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.2s-.7 1-.9 1.2c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.2-.6-.4M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2"/></svg>
</a>
