const activeSocials = socials.filter(s => (social[s.key] || '').trim());
---
<footer>
  <div class="wrap">
    <div class="f-top">
      <div class="f-brand">
        <img src="/logo.png" alt={site.name} class="brand-logo-f" />
        <p>Casting molds designed and manufactured in {site.city}. {site.tagline}.</p>
      </div>
      <div class="f-col">
        <h4>Moulds</h4>
        {materials.map(m => <a href={`/${m.slug}`}>{m.label}</a>)}
        <a href="/custom-moulds">Custom Moulds</a>
        <a href="/blog">Blog</a>
      </div>
      <div class="f-col">
        <h4>Contact</h4>
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp us</a>
        <a class="obf-mail" data-u={site.email.split("@")[0]} data-d={site.email.split("@")[1]} href="#">Email us</a>
        <a href="/#contact">Send an enquiry</a>
      </div>
    </div>
    {activeSocials.length > 0 && (
      <div class="f-social">
        {activeSocials.map(s => (
          <a href={social[s.key]} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d={s.icon}/></svg>
          </a>
        ))}
      </div>
    )}
    <div class="f-bot">
      <span class="mono">&copy; <span id="yr"></span> {site.name}</span>
      <span class="mono">{site.city}</span>
    </div>
  </div>
</footer>

<a href={`https://wa.me/${site.whatsapp}?text=Hi%2C%20I%20need%20a%20mold`} class="fab" target="_blank" rel="noopener" aria-label="WhatsApp">
