  { key:'social_facebook', label:'Facebook', icon:'M22 12a10 10 0 10-11.56 9.88v-7H7.9V12h2.54V9.8c0-2.5 1.5-3.9 3.78-3.9 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.9h-2.34v7A10 10 0 0022 12' },
  { key:'social_youtube', label:'YouTube', icon:'M23 7.5a2.8 2.8 0 00-2-2C19.2 5 12 5 12 5s-7.2 0-9 .5a2.8 2.8 0 00-2 2A29 29 0 001 12a29 29 0 00.5 4.5 2.8 2.8 0 002 2C5.3 19 12 19 12 19s7.2 0 9-.5a2.8 2.8 0 002-2A29 29 0 0023 12a29 29 0 00-.5-4.5M9.8 15.3V8.7l5.7 3.3-5.7 3.3' },
