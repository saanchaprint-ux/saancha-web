---
import { site, materials } from '../data/site.js';
import { supabaseAuth } from '../lib/supabase.js';

// social links from settings (admin-editable). Empty = icon hidden.
let social = {};
try {
  const sb = supabaseAuth();
  const { data } = await sb.from('settings').select('key,value')
    .in('key', ['social_facebook','social_youtube','social_linkedin','social_instagram','social_twitter']);
  social = Object.fromEntries((data||[]).map(r => [r.key, r.value]));
} catch(e) { social = {}; }

