---
import { site, nav, materials } from '../data/site.js';
const wa = `https://wa.me/${site.whatsapp}?text=Hi%2C%20I%20need%20a%20mold`;
---
<nav id="nav">
  <div class="wrap nav-in">
    <a href="/" class="brand" data-mag>
      <img src="/logo.png" alt={site.name} class="brand-logo" />
    </a>
    <div class="nav-links">
      <a href="/#process">Process</a>
      <div class="navdrop">
        <a href="/#materials" class="navdrop-t">Materials <span class="chev">&#9662;</span></a>
        <div class="navdrop-menu">
          {materials.map(m => <a href={`/${m.slug}`}>{m.label}</a>)}
        </div>
      </div>
      <a href="/#tiers">Options</a>
      <div class="navdrop acc-drop">
        <button class="acc-btn" aria-label="Account" data-cur="ACCOUNT">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/></svg>
        </button>
        <div class="navdrop-menu acc-menu">
          <!-- logged OUT -->
          <a href="/login" class="acc-out">Log in</a>
          <a href="/signup" class="acc-out">Sign up</a>
          <!-- logged IN (shown via JS) -->
          <a href="/account" class="acc-in" hidden>My account</a>
          <a href="/account#orders" class="acc-in" hidden>My orders</a>
          <a href="/logout" class="acc-in" hidden>Log out</a>
        </div>
      </div>
      <a href={wa} class="btn" target="_blank" rel="noopener" data-mag>WhatsApp</a>
      <button class="burger" id="burger" aria-label="Menu"><i></i><i></i></button>
    </div>
  </div>
</nav>

<div id="menu">
  <button class="close" id="mClose">CLOSE &#10005;</button>
  <div class="wrap">
    <ol>
      <li><a href="/">Home</a></li>
      {materials.map(m => <li><a href={`/${m.slug}`}>{m.label}</a></li>)}
      <li><a href="/#tiers">Options</a></li>
      <li class="m-account"><a href="/login">Log in</a></li>
      <li><a href="/#contact">Contact</a></li>
    </ol>
    <div class="m-foot">
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span class="mono">{site.city}</span>
    </div>
  </div>
</div>
