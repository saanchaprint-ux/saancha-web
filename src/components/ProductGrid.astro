---
import { site } from '../data/site.js';
const { products = [] } = Astro.props;
---
<div class="pgrid">
  {products.map(p => (
    <article class="pcard">
      <div class="shot">
        {p.image_url ? <img src={p.image_url} alt={p.name} loading="lazy" /> : <div class="shop-placeholder">SAANCHA</div>}
        <span class="tag2">{p.stock > 0 ? 'In stock' : 'Enquire'}</span>
      </div>
      <div class="b">
        <h3>{p.name}</h3>
        <span class="meta">{p.description}</span>
        <span class="mono">{p.category} / SKU: {p.base_sku}</span>
        <div class="row">
          <span class="price">₹{Number(p.price).toLocaleString('en-IN')}<small>Ready-made</small></span>
          <a class="enq" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi, I want to enquire about '+p.name+' (SKU: '+p.base_sku+').')}`} target="_blank" rel="noopener">Enquire →</a>
        </div>
      </div>
    </article>
  ))}
</div>
<style>.shop-placeholder{display:grid;place-items:center;width:100%;height:100%;min-height:230px;background:#1a1a1a;color:#dfa462;letter-spacing:.2em;font-size:14px}</style>
